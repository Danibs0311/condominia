# ==============================================================================
# CONDOMINIA - VARIÁVEIS DE AMBIENTE (PRODUÇÃO & INTEGRAÇÕES)
# Copie este arquivo para .env.local e preencha com suas chaves
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (BANCO DE DADOS POSTGRESQL & STORAGE DE NOTAS FISCAIS)
# Obtenha em: https://supabase.com -> Seu Projeto -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI (IA DE OCR DE NOTAS FISCAIS E REDAÇÃO DE COMUNICADOS)
# Obtenha em: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=sua-chave-api-gemini-aqui

# ------------------------------------------------------------------------------
# 3. GOOGLE DRIVE BACKUP (BACKUP EM NUVEM DE NOTAS FISCAIS E BALANCETES)
# Obtenha em: Google Cloud Console -> APIs & Services -> Credentials
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_CLIENT_ID=seu-client-id-google.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=seu-client-secret-aqui
GOOGLE_DRIVE_REFRESH_TOKEN=seu-refresh-token-aqui
GOOGLE_DRIVE_BACKUP_FOLDER_ID=id-da-pasta-raiz-de-backup-no-drive

# ------------------------------------------------------------------------------
# 4. CONFIGURAÇÕES GERAIS DA APLICAÇÃO
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://condominia.com.br
NEXT_PUBLIC_SUPPORT_WHATSAPP=5575988481160
